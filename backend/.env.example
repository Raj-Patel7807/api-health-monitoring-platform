APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/api_health
REDIS_URL=redis://localhost:6379/0
LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# AI incident assistance — optional. Set LLM_PROVIDER=deterministic (default, no API key needed)
# or LLM_PROVIDER=gemini and provide your Gemini API key to use the LLM provider.
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash-exp

# AES-256 key (base64url, 32 bytes) used to encrypt secrets at rest.
# Generate your own with:  python -m app.core.crypto
# Never commit a real key. Leave blank here; set it in your local .env.
ENCRYPTION_KEY=

# JWT secret key — used to sign access and refresh tokens.
# Generate your own with:  python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real key. Leave blank here; set it in your local .env.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
